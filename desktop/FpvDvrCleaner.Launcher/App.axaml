<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FpvDvrCleaner.Launcher.App"
             RequestedThemeVariant="Dark">
    <!-- The launcher is dark only; the title bar follows the variant on Windows. -->

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#FFE07A2E" />
            </FluentTheme.Palettes>
        </FluentTheme>
    </Application.Styles>
</Application>
